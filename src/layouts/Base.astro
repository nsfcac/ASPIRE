---
import '../styles/global.css';
import { site, visibleNav } from '../data/site';

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  lede?: string;
  section?: string;
}

const { title, description, eyebrow, lede, section } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const here = Astro.url.pathname.replace(base, '').replace(/\/$/, '') || '/';
const link = (href: string) => (href === '/' ? `${base}/` : `${base}${href}`);
const pageTitle = title === site.acronym ? `${site.acronym} — NSF REU Site` : `${title} · ${site.acronym} REU Site`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? site.tagline} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description ?? site.tagline} />
    <meta property="og:type" content="website" />
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem('aspire-theme');
          if (t) document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand-link" href={link('/')}>
          <span class="mark" aria-hidden="true"></span>
          {site.acronym}
          <span class="sub">NSF REU Site</span>
        </a>
        <nav class="main" aria-label="Main">
          {visibleNav.map((n) => (
            <a href={link(n.href)} aria-current={here === n.href ? 'page' : undefined}>{n.label}</a>
          ))}
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle color theme" title="Toggle light / dark">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    {(eyebrow || lede) && (
      <div class="page-head">
        <div class="wrap">
          {eyebrow && <div class="eyebrow">{eyebrow}{section ? ` · Proposal Section ${section}` : ''}</div>}
          <h1>{title}</h1>
          {lede && <p class="lede">{lede}</p>}
        </div>
      </div>
    )}

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p style="margin-bottom:.6rem">
          <strong style="color:var(--text-secondary)">{site.shortTitle}</strong> — {site.institution}, {site.college}.
        </p>
        <p style="margin-bottom:0">
          Pages: {visibleNav.map((n, i) => (
            <Fragment>{i === 0 ? '' : ' · '}<a href={link(n.href)}>{n.label}</a></Fragment>
          ))}
        </p>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const current =
          root.getAttribute('data-theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('aspire-theme', next); } catch (e) {}
      });
    </script>
  </body>
</html>
