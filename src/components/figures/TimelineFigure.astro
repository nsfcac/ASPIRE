---
import { timetable, activityKindLabels, type ActivityKind } from '../../data/team';

const labelW = 168;
const x0 = labelW + 8;
const cellW = 76;
const weeks = 10;

const kinds: ActivityKind[] = ['training', 'mentoring', 'community', 'cultural', 'assessment', 'dissemination'];

// activities per kind per week — the code is what fits in the chip, the name is
// what the chip's tooltip spells out, since A2.3 tells a first-time reader nothing.
const chips = kinds.map((k) => ({
  kind: k,
  weeks: timetable.map((w) => w.activities.filter((a) => a.kind === k)),
}));

const phases = [
  { label: 'Phase 1 · Training, tooling & baselines', mid: 'Phase 1 · Training', from: 1, to: 3, fill: 'var(--ord-1)', ink: '#0b1c30' },
  { label: 'Phase 2 · Focused investigation & experiments', mid: 'Phase 2 · Investigation', from: 4, to: 7, fill: 'var(--ord-2)', ink: '#ffffff' },
  { label: 'Phase 3 · Validation & communication', mid: 'Phase 3 · Validation', from: 8, to: 10, fill: 'var(--ord-3)', ink: '#ffffff' },
];

const rowY = (i: number) => 118 + i * 42;
const height = rowY(kinds.length) + 46;
const gridBottom = rowY(kinds.length) - 8;

/**
 * Hovering anywhere in a week — its header or any activity chip in it — lights the
 * whole column and dims the other nine, which is how you read "what happens in
 * week 5" off a grid this dense. Hovering a phase bar does the same for the weeks
 * that phase spans. Neither is expressible in plain CSS without counting columns,
 * so the rules are generated per week and per phase, and emitted globally: they
 * are namespaced under .timeline-fig already, and Astro's scoping would not reach
 * the pseudo-class arguments anyway.
 *
 * Resting appearance stays in presentational attributes — scripts/export-figures.mjs
 * lifts the <svg> out with no stylesheet, so anything unconditional here would go
 * missing from the exported PDF.
 */
const weekCss = Array.from({ length: weeks }, (_, i) => {
  const on = `.timeline-fig:has(.w${i}:hover)`;
  return `
${on} .colband.w${i} { fill: var(--surface-2); }
${on} .cell:not(.w${i}) { opacity: .32; }
${on} .wk.w${i} .wkbox { fill: var(--surface-3); stroke: var(--border-strong); }`;
});

const phaseCss = phases.map((p, j) => {
  const on = `.timeline-fig:has(.ph${j}:hover)`;
  const bands = Array.from({ length: p.to - p.from + 1 }, (_, k) => `${on} .colband.w${p.from - 1 + k}`).join(', ');
  return `
${on} .ph:not(.ph${j}) { opacity: .32; }
${bands} { fill: var(--surface-2); }`;
});

const hoverCss = [...weekCss, ...phaseCss].join('');
---

<svg viewBox={`0 0 960 ${height}`} role="img" aria-labelledby="tl-title tl-desc" class="timeline-fig">
  <title id="tl-title">Ten-week ASPIRE program schedule</title>
  <desc id="tl-desc">
    A ten-week grid. A typical research project runs three phases: weeks 1 to 3 training and baselines,
    weeks 4 to 7 focused investigation, and weeks 8 to 10 validation and communication. Cohort activities —
    training seminars, mentoring, community building, cultural visits, assessment and dissemination — are
    distributed across the ten weeks and labeled with the activity codes used in the program timetable.
  </desc>

  {/* One unpainted band per week, behind everything and deaf to the pointer, so it
      never steals hover from the chips it sits under. The generated rules tint the
      band of whichever week is being read. */}
  {Array.from({ length: weeks }, (_, i) => (
    <rect
      class={`colband w${i}`}
      x={x0 + i * cellW - 2}
      y="40"
      width={cellW}
      height={gridBottom - 40}
      fill="none"
      pointer-events="none"
    />
  ))}

  <!-- week header -->
  {Array.from({ length: weeks }, (_, i) => (
    <g class={`wk w${i}`}>
      <rect class="wkbox" x={x0 + i * cellW} y="8" width={cellW - 4} height="26" rx="5" fill="var(--surface-2)" />
      <text x={x0 + i * cellW + (cellW - 4) / 2} y="26" font-size="12" font-weight="700" text-anchor="middle" fill="var(--text-secondary)">W{i + 1}</text>
    </g>
  ))}
  {Array.from({ length: weeks + 1 }, (_, i) => (
    <line x1={x0 + i * cellW - 2} y1="40" x2={x0 + i * cellW - 2} y2={gridBottom} stroke="var(--grid)" stroke-width="1" />
  ))}

  <!-- research phase band -->
  <text x="0" y="62" font-size="12.5" font-weight="700" fill="var(--text-primary)">Research phases</text>
  <text x="0" y="78" font-size="11" fill="var(--text-muted)">typical project arc</text>
  {phases.map((p, j) => {
    const x = x0 + (p.from - 1) * cellW;
    const w = (p.to - p.from + 1) * cellW - 6;
    return (
      <g class={`ph ph${j}`}>
        <title>{`${p.label} · weeks ${p.from}–${p.to}`}</title>
        <rect x={x} y="50" width={w} height="34" rx="4" fill={p.fill} />
        <text x={x + 12} y="72" font-size="12" font-weight="600" fill={p.ink}>
          {w > 320 ? p.label : p.mid}
        </text>
      </g>
    );
  })}

  <!-- ownership arc annotation -->
  <text x={x0} y="102" font-size="11" fill="var(--text-muted)">structured onboarding</text>
  <text x={x0 + 3.2 * cellW} y="102" font-size="11" fill="var(--text-muted)">guided investigation, growing student ownership</text>
  <text x={x0 + 7.2 * cellW} y="102" font-size="11" fill="var(--text-muted)">student-led synthesis</text>

  <!-- cohort activity rows -->
  {chips.map((row, ri) => (
    <g>
      <text x="0" y={rowY(ri) + 17} font-size="12.5" font-weight="600" fill="var(--text-secondary)">{activityKindLabels[row.kind]}</text>
      {row.weeks.map((acts, wi) =>
        acts.length ? (
          <g class={`cell w${wi}`}>
            <title>{`Week ${wi + 1} — ${acts.map((a) => `${a.code} ${a.name}`).join(' · ')}`}</title>
            <rect x={x0 + wi * cellW} y={rowY(ri)} width={cellW - 6} height="26" rx="5" fill="var(--surface-2)" stroke="var(--border-strong)" />
            <text
              x={x0 + wi * cellW + (cellW - 6) / 2}
              y={rowY(ri) + 17}
              font-size={acts.length > 1 ? 9.5 : 11}
              text-anchor="middle"
              fill="var(--text-secondary)"
              font-family="var(--font-mono)"
            >
              {acts.map((a) => a.code).join(' ')}
            </text>
          </g>
        ) : null
      )}
    </g>
  ))}

  <!-- milestones -->
  <line x1={x0} y1={gridBottom + 6} x2={x0 + weeks * cellW - 6} y2={gridBottom + 6} stroke="var(--border)" stroke-width="1" />
  {[
    { w: 1, t: 'Project selection' },
    { w: 5, t: 'Mid-program review' },
    { w: 8, t: 'Draft report' },
    { w: 10, t: 'Public symposium' },
  ].map((m) => (
    <g>
      <circle cx={x0 + (m.w - 1) * cellW + (cellW - 6) / 2} cy={gridBottom + 6} r="4.5" fill="var(--brand)" stroke="var(--surface-1)" stroke-width="2" />
      <text
        x={x0 + (m.w - 1) * cellW + (cellW - 6) / 2}
        y={gridBottom + 26}
        font-size="11"
        font-weight="600"
        text-anchor={m.w === 10 ? 'end' : m.w === 1 ? 'start' : 'middle'}
        fill="var(--text-secondary)"
      >
        {m.t}
      </text>
    </g>
  ))}
  <text x="0" y={gridBottom + 26} font-size="11.5" font-weight="700" fill="var(--text-primary)">Milestones</text>
</svg>

<style is:global set:html={hoverCss}></style>

<style>
  .timeline-fig { min-width: 880px; }
  .timeline-fig .cell, .timeline-fig .ph { transition: opacity 0.15s ease; }
  /* transparent, not the attribute's `none`, so the tint fades in rather than snaps. */
  .timeline-fig .colband { fill: transparent; }
  .timeline-fig .colband, .timeline-fig .wkbox { transition: fill 0.15s ease, stroke 0.15s ease; }
  @media (prefers-reduced-motion: reduce) {
    .timeline-fig .cell, .timeline-fig .ph, .timeline-fig .colband, .timeline-fig .wkbox { transition: none; }
  }
</style>
