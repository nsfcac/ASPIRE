---
import { timetable, activityKindLabels, type ActivityKind } from '../../data/team';

const labelW = 168;
const x0 = labelW + 8;
const cellW = 76;
const weeks = 10;

const kinds: ActivityKind[] = ['training', 'mentoring', 'community', 'assessment', 'dissemination'];

// codes per kind per week
const chips = kinds.map((k) => ({
  kind: k,
  weeks: timetable.map((w) => w.activities.filter((a) => a.kind === k).map((a) => a.code)),
}));

const phases = [
  { label: 'Phase 1 · Training, tooling & baselines', mid: 'Phase 1 · Training', from: 1, to: 3, fill: 'var(--ord-1)', ink: '#0b1c30' },
  { label: 'Phase 2 · Focused investigation & experiments', mid: 'Phase 2 · Investigation', from: 4, to: 7, fill: 'var(--ord-2)', ink: '#ffffff' },
  { label: 'Phase 3 · Validation & communication', mid: 'Phase 3 · Validation', from: 8, to: 10, fill: 'var(--ord-3)', ink: '#ffffff' },
];

const rowY = (i: number) => 118 + i * 42;
const height = rowY(kinds.length) + 46;
const gridBottom = rowY(kinds.length) - 8;
---

<svg viewBox={`0 0 960 ${height}`} role="img" aria-labelledby="tl-title tl-desc" class="timeline-fig">
  <title id="tl-title">Ten-week ASPIRE program schedule</title>
  <desc id="tl-desc">
    A ten-week grid. A typical research project runs three phases: weeks 1 to 3 training and baselines,
    weeks 4 to 7 focused investigation, and weeks 8 to 10 validation and communication. Cohort activities —
    training seminars, mentoring, community building, assessment and dissemination — are distributed across
    the ten weeks and labeled with the activity codes used in the program timetable.
  </desc>

  <!-- week header -->
  {Array.from({ length: weeks }, (_, i) => (
    <g>
      <rect x={x0 + i * cellW} y="8" width={cellW - 4} height="26" rx="5" fill="var(--surface-2)" />
      <text x={x0 + i * cellW + (cellW - 4) / 2} y="26" font-size="12" font-weight="700" text-anchor="middle" fill="var(--text-secondary)">W{i + 1}</text>
    </g>
  ))}
  {Array.from({ length: weeks + 1 }, (_, i) => (
    <line x1={x0 + i * cellW - 2} y1="40" x2={x0 + i * cellW - 2} y2={gridBottom} stroke="var(--grid)" stroke-width="1" />
  ))}

  <!-- research phase band -->
  <text x="0" y="62" font-size="12.5" font-weight="700" fill="var(--text-primary)">Research phases</text>
  <text x="0" y="78" font-size="11" fill="var(--text-muted)">typical project arc</text>
  {phases.map((p) => {
    const x = x0 + (p.from - 1) * cellW;
    const w = (p.to - p.from + 1) * cellW - 6;
    return (
      <g>
        <rect x={x} y="50" width={w} height="34" rx="4" fill={p.fill} />
        <text x={x + 12} y="72" font-size="12" font-weight="600" fill={p.ink}>
          {w > 320 ? p.label : p.mid}
        </text>
      </g>
    );
  })}

  <!-- ownership arc annotation -->
  <text x={x0} y="102" font-size="11" fill="var(--text-muted)">structured onboarding</text>
  <text x={x0 + 3.2 * cellW} y="102" font-size="11" fill="var(--text-muted)">guided investigation, growing student ownership</text>
  <text x={x0 + 7.2 * cellW} y="102" font-size="11" fill="var(--text-muted)">student-led synthesis</text>

  <!-- cohort activity rows -->
  {chips.map((row, ri) => (
    <g>
      <text x="0" y={rowY(ri) + 17} font-size="12.5" font-weight="600" fill="var(--text-secondary)">{activityKindLabels[row.kind]}</text>
      {row.weeks.map((codes, wi) =>
        codes.length ? (
          <g>
            <rect x={x0 + wi * cellW} y={rowY(ri)} width={cellW - 6} height="26" rx="5" fill="var(--surface-2)" stroke="var(--border-strong)" />
            <text
              x={x0 + wi * cellW + (cellW - 6) / 2}
              y={rowY(ri) + 17}
              font-size={codes.length > 1 ? 9.5 : 11}
              text-anchor="middle"
              fill="var(--text-secondary)"
              font-family="var(--font-mono)"
            >
              {codes.join(' ')}
            </text>
          </g>
        ) : null
      )}
    </g>
  ))}

  <!-- milestones -->
  <line x1={x0} y1={gridBottom + 6} x2={x0 + weeks * cellW - 6} y2={gridBottom + 6} stroke="var(--border)" stroke-width="1" />
  {[
    { w: 1, t: 'Project selection' },
    { w: 5, t: 'Mid-program review' },
    { w: 8, t: 'Draft report' },
    { w: 10, t: 'Public symposium' },
  ].map((m) => (
    <g>
      <circle cx={x0 + (m.w - 1) * cellW + (cellW - 6) / 2} cy={gridBottom + 6} r="4.5" fill="var(--brand)" stroke="var(--surface-1)" stroke-width="2" />
      <text
        x={x0 + (m.w - 1) * cellW + (cellW - 6) / 2}
        y={gridBottom + 26}
        font-size="11"
        font-weight="600"
        text-anchor={m.w === 10 ? 'end' : m.w === 1 ? 'start' : 'middle'}
        fill="var(--text-secondary)"
      >
        {m.t}
      </text>
    </g>
  ))}
  <text x="0" y={gridBottom + 26} font-size="11.5" font-weight="700" fill="var(--text-primary)">Milestones</text>
</svg>

<style>
  .timeline-fig { min-width: 880px; }
</style>
