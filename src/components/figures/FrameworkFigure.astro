---
import { thrusts, projects, type ThrustId } from '../../data/projects';

const order: ThrustId[] = ['systems', 'ai-systems', 'trust'];
const colW = 296;
const gap = 20;
const startX = 20;
const cardY = 476;
const cardH = 170;

// Wrap into two lines (sequential, not greedy-refill). Done in frontmatter:
// expressions containing `<` confuse the Astro template compiler.
const wrap2 = (text: string, max: number): [string, string] => {
  const words = text.split(' ');
  let a = '';
  let i = 0;
  while (i < words.length && (a + ' ' + words[i]).trim().length <= max) {
    a = (a + ' ' + words[i]).trim();
    i += 1;
  }
  let b = words.slice(i).join(' ');
  if (b.length > max) b = b.slice(0, max - 1).trimEnd() + '…';
  return [a, b];
};

const titleLines = new Map(projects.map((p) => [p.id, wrap2(p.title, 42)]));

/**
 * Each project line in the thrust band links to that project's page, and carries
 * tabindex="-1": role="img" on the <svg> makes the subtree presentational, so a
 * focus stop here would announce nothing. The same nine links are real links in
 * the project index.
 */

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const drivers = [
  ['AI-ready U.S. workforce', 'NSF FY 2026–2030 Strategic Plan'],
  ['Compute, memory and energy', 'demands of modern AI models'],
  ['NSF-funded advanced', 'cyberinfrastructure'],
];
---

<svg viewBox="0 0 960 736" role="img" aria-labelledby="fw-title fw-desc" class="framework-fig">
  <title id="fw-title">ASPIRE program framework</title>
  <desc id="fw-desc">
    National drivers feed an intellectual core at the intersection of artificial intelligence and
    high-performance computing. That core is organized into three research thrusts — HPC systems and
    performance, efficient and applied AI systems, and security, trust and learning — which contain the
    nine REU projects and lead to student and workforce outcomes.
  </desc>

  <defs>
    <marker id="fw-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" fill="var(--axis)" />
    </marker>
    <clipPath id="fw-clip-ai">
      <circle cx="370" cy="285" r="165" />
    </clipPath>
  </defs>

  <!-- Band 1: national drivers -->
  <text x="20" y="22" font-size="12" font-weight="700" letter-spacing="1.2" fill="var(--text-muted)">NATIONAL AND NSF CONTEXT</text>
  {drivers.map((lines, i) => (
    <g>
      <rect x={20 + i * (colW + gap)} y={34} width={colW} height={52} rx="8" fill="var(--surface-2)" stroke="var(--border)" />
      <text x={20 + i * (colW + gap) + colW / 2} y={55} font-size="13" font-weight="600" text-anchor="middle" fill="var(--text-primary)">{lines[0]}</text>
      <text x={20 + i * (colW + gap) + colW / 2} y={73} font-size="12" text-anchor="middle" fill="var(--text-secondary)">{lines[1]}</text>
    </g>
  ))}

  <path d="M480 92 L480 108" stroke="var(--axis)" stroke-width="2" marker-end="url(#fw-arrow)" />

  <!-- Band 2: the intersection -->
  <circle cx="370" cy="285" r="165" fill="var(--c-1-soft)" stroke="var(--c-1)" stroke-width="2" />
  <circle cx="590" cy="285" r="165" fill="var(--c-2-soft)" stroke="var(--c-2)" stroke-width="2" />
  <g clip-path="url(#fw-clip-ai)">
    <circle cx="590" cy="285" r="165" fill="var(--surface-3)" stroke="var(--c-2)" stroke-width="2" />
  </g>

  <text x="315" y="263" font-size="16" font-weight="700" text-anchor="middle" fill="var(--text-primary)">Artificial</text>
  <text x="315" y="283" font-size="16" font-weight="700" text-anchor="middle" fill="var(--text-primary)">Intelligence</text>
  <text x="315" y="307" font-size="12" text-anchor="middle" fill="var(--text-secondary)">agentic AI · LLMs</text>
  <text x="315" y="324" font-size="12" text-anchor="middle" fill="var(--text-secondary)">retrieval · model safety</text>

  <text x="645" y="263" font-size="16" font-weight="700" text-anchor="middle" fill="var(--text-primary)">High-Performance</text>
  <text x="645" y="283" font-size="16" font-weight="700" text-anchor="middle" fill="var(--text-primary)">Computing</text>
  <text x="645" y="307" font-size="12" text-anchor="middle" fill="var(--text-secondary)">GPUs · scheduling</text>
  <text x="645" y="324" font-size="12" text-anchor="middle" fill="var(--text-secondary)">telemetry · power</text>

  <text x="480" y="253" font-size="14" font-weight="700" text-anchor="middle" fill="var(--text-primary)">ASPIRE</text>
  <text x="480" y="275" font-size="11.5" text-anchor="middle" fill="var(--text-secondary)">efficient</text>
  <text x="480" y="291" font-size="11.5" text-anchor="middle" fill="var(--text-secondary)">inference,</text>
  <text x="480" y="307" font-size="11.5" text-anchor="middle" fill="var(--text-secondary)">optimization,</text>
  <text x="480" y="323" font-size="11.5" text-anchor="middle" fill="var(--text-secondary)">deployment</text>

  <path d="M480 454 L480 470" stroke="var(--axis)" stroke-width="2" marker-end="url(#fw-arrow)" />

  <!-- Band 3: three thrusts -->
  {order.map((key, i) => {
    const t = thrusts[key];
    const x = startX + i * (colW + gap);
    return (
      /* Marked .hl so hovering one thrust dims the other two — the band is the one
         place on the site where all nine projects sit side by side, and three at a
         time is the readable unit. */
      <g class="hl">
        <rect class="card" x={x} y={cardY} width={colW} height={cardH} rx="10" fill="var(--surface-1)" stroke="var(--border)" />
        <rect x={x} y={cardY} width={colW} height="4" rx="2" fill={t.color} />
        <text x={x + 16} y={cardY + 30} font-size="14.5" font-weight="700" fill="var(--text-primary)">{t.name}</text>
        {t.projects.map((pid, j) => {
          const p = projects.find((pp) => pp.id === pid)!;
          const lines = titleLines.get(pid)!;
          const y = cardY + 52 + j * 40;
          return (
            <a class="chip" href={`${base}/projects/${p.slug}`} tabindex="-1" aria-label={`Project ${p.id}. ${p.title}`}>
              <title>{p.title}</title>
              {/* Unpainted at rest; it makes the whole line, not just the badge, clickable. */}
              <rect class="hit" x={x + 12} y={y - 4} width={colW - 24} height="30" rx="5" fill="none" pointer-events="all" />
              <rect x={x + 14} y={y} width="26" height="18" rx="4" fill={t.color} />
              <text x={x + 27} y={y + 13.5} font-size="11" font-weight="700" text-anchor="middle" fill="var(--surface-0)">P{p.id}</text>
              <text class="ct" x={x + 48} y={y + 9} font-size="11.5" fill="var(--text-secondary)">{lines[0]}</text>
              <text class="ct" x={x + 48} y={y + 23} font-size="11.5" fill="var(--text-secondary)">{lines[1]}</text>
            </a>
          );
        })}
      </g>
    );
  })}

  <path d="M480 652 L480 668" stroke="var(--axis)" stroke-width="2" marker-end="url(#fw-arrow)" />

  <!-- Band 4: outcomes -->
  <rect x="20" y="674" width="920" height="52" rx="10" fill="var(--surface-2)" stroke="var(--border)" />
  <text x="36" y="696" font-size="12" font-weight="700" letter-spacing="1.2" fill="var(--text-muted)">OUTCOMES</text>
  <text x="36" y="714" font-size="13" fill="var(--text-secondary)">
    Research skills and computing identity · reproducible artifacts, reports and posters · graduate-school pathways · an AI-ready workforce
  </text>
</svg>

<style>
  .framework-fig { min-width: 720px; }
  .framework-fig .card { transition: stroke 0.18s ease; }
  .framework-fig .hl:hover .card { stroke: var(--border-strong); }
  /* transparent, not the attribute's `none`, so the row tint can fade. */
  .framework-fig .hit { fill: transparent; transition: fill 0.15s ease; }
  .framework-fig .chip:hover .hit { fill: var(--surface-2); }
  .framework-fig .chip:hover .ct { fill: var(--text-primary); }
  @media (prefers-reduced-motion: reduce) {
    .framework-fig .card, .framework-fig .hit { transition: none; }
  }
</style>
