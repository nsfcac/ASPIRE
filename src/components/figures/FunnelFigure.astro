---
const stages = [
  {
    label: 'Nationwide recruitment',
    width: 400,
    fill: 'var(--ord-1)',
    ink: '#0b1c30',
    detail: [
      'TTU, college, department and NSF REU webpages; university social media',
      'Departmental mailing lists; ACM student chapters; faculty professional networks',
      'ACM-W, CRA-WP, IEEE WIE, SWE, NCWIT; conferences such as SIGCSE',
      'TTU STEM CORE partner network and partner institutions',
    ],
  },
  {
    label: 'Applications via NSF ETAP',
    width: 344,
    fill: 'var(--ord-1)',
    ink: '#0b1c30',
    detail: [
      'Resume · personal statement (≤ 500 words) · undergraduate transcript',
      'Two faculty recommendations · checklist of completed or ongoing coursework',
    ],
  },
  {
    label: 'Eligibility screening',
    width: 292,
    fill: 'var(--ord-2)',
    ink: '#ffffff',
    detail: [
      'NSF eligibility; sophomore standing or beyond at program start',
      'Programming and data structures/algorithms coursework',
      'AI, cybersecurity, OS, math or HPC coursework informs project assignment',
      'Prior research experience is not required',
    ],
  },
  {
    label: 'Two independent review teams',
    width: 240,
    fill: 'var(--ord-2)',
    ink: '#ffffff',
    detail: [
      'Each team = PI or Co-PI + two research mentors',
      'Applications scored on the five-criterion rubric (see below)',
    ],
  },
  {
    label: 'Team review and ranking',
    width: 188,
    fill: 'var(--ord-3)',
    ink: '#ffffff',
    detail: ['Full project team reviews scores and produces a ranked list', 'If an offer is declined, the next ranked qualified applicant is invited'],
  },
  {
    label: '10 participants',
    width: 136,
    fill: 'var(--ord-3)',
    ink: '#ffffff',
    detail: ['Selected on skills, interests, preparation, project fit and growth potential', 'Project matching, structured onboarding and mentor-guided support follow'],
  },
];

const top = 34;
const rowH = 74;
const height = top + stages.length * rowH + 12;
const cx = 214;
---

<svg viewBox={`0 0 960 ${height}`} role="img" aria-labelledby="fn-title fn-desc" class="funnel-fig">
  <title id="fn-title">Recruitment and selection funnel</title>
  <desc id="fn-desc">
    Six stages narrow from nationwide recruitment, through applications submitted in NSF ETAP, eligibility
    screening, review by two independent teams using a weighted rubric, whole-team ranking, to a cohort of
    ten selected participants.
  </desc>

  <text x="12" y="18" font-size="12" font-weight="700" letter-spacing="1.1" fill="var(--text-muted)">SELECTION FUNNEL</text>
  <text x="440" y="18" font-size="12" font-weight="700" letter-spacing="1.1" fill="var(--text-muted)">WHAT HAPPENS AT THIS STAGE</text>

  {stages.map((s, i) => {
    const y = top + i * rowH;
    return (
      /* One stage = its funnel bar plus the detail column on its right. Marked .hl
         so hovering either half dims the other five stages and leaves one stage of
         the process on screen by itself. */
      <g class="hl">
        {/* Unpainted at rest — it only widens the hover target to the whole band. */}
        <rect class="hit" x="0" y={y - 8} width="960" height={rowH} fill="none" pointer-events="all" />
        {/* Bar and label share a group so the hover scale moves them together. */}
        <g class="bar">
          <rect x={cx - s.width / 2} y={y} width={s.width} height="44" rx="6" fill={s.fill} />
          <text x={cx} y={y + 28} font-size={s.width < 200 ? 12 : 13} font-weight="700" text-anchor="middle" fill={s.ink}>
            {s.label}
          </text>
        </g>
        {i < stages.length - 1 && (
          <path d={`M${cx - 7} ${y + 48} L${cx + 7} ${y + 48} L${cx} ${y + 60} z`} fill="var(--axis)" />
        )}
        <line x1="432" y1={y - 6} x2="948" y2={y - 6} stroke="var(--grid)" stroke-width="1" />
        {s.detail.map((d, j) => (
          <text x="440" y={y + 14 + j * 16} font-size="11.5" fill="var(--text-secondary)">
            <tspan fill="var(--axis)">•</tspan> {d.length > 80 ? d.slice(0, 79) + '…' : d}
          </text>
        ))}
      </g>
    );
  })}
</svg>

<style>
  .funnel-fig { min-width: 860px; }
  /* The bar of the hovered stage lifts slightly out of the funnel toward its
     detail column. transform-box keeps the origin in the bar's own box rather
     than the SVG's, which is what makes a plain `scale` behave here. */
  .funnel-fig .bar { transform-box: fill-box; transform-origin: center; transition: transform 0.18s ease; }
  .funnel-fig .hl:hover .bar { transform: scale(1.03); }
  @media (prefers-reduced-motion: reduce) {
    .funnel-fig .bar { transition: none; }
    .funnel-fig .hl:hover .bar { transform: none; }
  }
</style>
