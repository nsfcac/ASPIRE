---
import { mentors } from '../../data/team';
import { projects, thrusts, thrustOf } from '../../data/projects';

const mBoxW = 244;
const mBoxH = 62;
const mX = 8;
const mStep = 86;
const mTop = 42;
const mCY = (i: number) => mTop + i * mStep + mBoxH / 2;

const pBoxW = 340;
const pBoxH = 34;
const pX = 560;
const pStep = 46;
const pTop = 30;
const pCY = (i: number) => pTop + i * pStep + pBoxH / 2;

const height = Math.max(mTop + mentors.length * mStep, pTop + projects.length * pStep) + 46;
const clip = (s: string, n: number) => (s.length > n ? s.slice(0, n - 1).trimEnd() + '…' : s);

/** Every mentor index that supervises a project, so its box can carry their m-classes. */
const mentorsOf = (pid: number) =>
  mentors.flatMap((m, i) => (m.projects.includes(pid) ? [i] : []));

/**
 * Hovering either end of the map dims everything not connected to it. The rules have
 * to correlate the hovered node with the links and boxes on the other side, which plain
 * CSS cannot express generically — so one rule group per mentor and per project is
 * generated here instead. Emitted inline (not as a scoped <style>) because the selectors
 * are already namespaced under .mentormap-fig.
 *
 * Resting appearance stays entirely in presentational attributes: scripts/export-figures.mjs
 * lifts the bare <svg> out of the built HTML with no stylesheet attached, so anything
 * these rules did unconditionally would be missing from the exported PDF.
 */
const DIM = '{ opacity: .12; }';
const LIT = '{ opacity: 1; stroke-width: 3; }';
const BOX = '{ stroke: var(--border-strong); stroke-width: 1.5; }';

/** Mentor → their projects. Every node carrying the mentor's class survives. */
const fromMentor = mentors.map((_, i) => {
  const on = `.mentormap-fig:has(.mnode.m${i}:hover)`;
  return `
${on} .node:not(.m${i}), ${on} .link:not(.m${i}) ${DIM}
${on} .link.m${i} ${LIT}
${on} .pnode.m${i} .box ${BOX}`;
});

/**
 * Project → its mentors. The mirror image needs a different keep-set: a co-mentored
 * project shares its m-classes with the mentor's *other* projects, so keying off those
 * would light those up too. Only the hovered project and the mentor boxes themselves
 * survive, matched as `.mnode.m<i>` so sibling projects stay dimmed.
 */
const fromProject = projects.map((p) => {
  const on = `.mentormap-fig:has(.pnode.p${p.id}:hover)`;
  const keep = mentorsOf(p.id).map((i) => `:not(.mnode.m${i})`).join('');
  const boxes = mentorsOf(p.id).map((i) => `${on} .mnode.m${i} .box`).join(', ');
  return `
${on} .node:not(.pnode.p${p.id})${keep}, ${on} .link:not(.p${p.id}) ${DIM}
${on} .link.p${p.id} ${LIT}
${boxes} ${BOX}`;
});

const hoverCss = [...fromMentor, ...fromProject].join('');
---

<svg viewBox={`0 0 920 ${height}`} role="img" aria-labelledby="mm-title mm-desc" class="mentormap-fig">
  <title id="mm-title">Which mentors supervise which projects</title>
  <desc id="mm-desc">
    Five research mentors connect to nine projects. Dr. Chen and Dr. Li co-mentor the four HPC systems and
    AI-for-HPC projects; Dr. Amjad mentors the two applied AI systems projects; Dr. Mengel mentors the
    energy security and GPU education projects; Dr. Salman mentors the prompt injection project.
  </desc>

  <text x="8" y="20" font-size="12" font-weight="700" letter-spacing="1.1" fill="var(--text-muted)">RESEARCH MENTORS</text>
  <text x={pX} y="20" font-size="12" font-weight="700" letter-spacing="1.1" fill="var(--text-muted)">PROJECTS</text>

  <!-- links first so nodes sit on top -->
  {mentors.map((m, mi) =>
    m.projects.map((pid) => {
      const pi = projects.findIndex((p) => p.id === pid);
      const t = thrusts[thrustOf(pid)];
      const y1 = mCY(mi);
      const y2 = pCY(pi);
      const x1 = mX + mBoxW;
      const x2 = pX;
      const mid = (x1 + x2) / 2;
      return (
        <path
          class={`link m${mi} p${pid}`}
          d={`M${x1} ${y1} C ${mid} ${y1}, ${mid} ${y2}, ${x2} ${y2}`}
          fill="none"
          stroke={t.color}
          stroke-width="1.75"
          opacity="0.65"
        />
      );
    })
  )}

  {mentors.map((m, i) => (
    <g class={`node mnode m${i}`}>
      <rect class="box" x={mX} y={mTop + i * mStep} width={mBoxW} height={mBoxH} rx="9" fill="var(--surface-1)" stroke="var(--border-strong)" />
      <text x={mX + 14} y={mTop + i * mStep + 24} font-size="13" font-weight="700" fill="var(--text-primary)">{m.name}</text>
      <text x={mX + 14} y={mTop + i * mStep + 41} font-size="11" fill="var(--text-muted)">{clip(m.role, 34)}</text>
      <text x={mX + 14} y={mTop + i * mStep + 55} font-size="11" fill="var(--text-secondary)">{clip(m.expertise[0], 36)}</text>
    </g>
  ))}

  {projects.map((p, i) => {
    const t = thrusts[thrustOf(p.id)];
    return (
      <g class={['node pnode', `p${p.id}`, ...mentorsOf(p.id).map((mi) => `m${mi}`)].join(' ')}>
        <rect class="box" x={pX} y={pTop + i * pStep} width={pBoxW} height={pBoxH} rx="7" fill="var(--surface-1)" stroke="var(--border)" />
        <rect x={pX} y={pTop + i * pStep} width="4" height={pBoxH} rx="2" fill={t.color} />
        <text x={pX + 14} y={pTop + i * pStep + 15} font-size="11.5" font-weight="700" fill="var(--text-primary)">Project {p.id}</text>
        <text x={pX + 70} y={pTop + i * pStep + 15} font-size="11.5" fill="var(--text-secondary)">{clip(p.title, 40)}</text>
        <text x={pX + 14} y={pTop + i * pStep + 28} font-size="10.5" fill="var(--text-muted)">{t.name}</text>
      </g>
    );
  })}

  <g transform={`translate(8, ${height - 20})`}>
    {(['systems', 'ai-systems', 'trust'] as const).map((k, i) => (
      <g transform={`translate(${i * 250}, 0)`}>
        <rect x="0" y="-10" width="14" height="14" rx="3" fill={thrusts[k].color} />
        <text x="20" y="1.5" font-size="11.5" fill="var(--text-secondary)">{thrusts[k].name}</text>
      </g>
    ))}
  </g>
</svg>

<style is:global set:html={hoverCss}></style>

<style>
  .mentormap-fig { min-width: 780px; }
  /* Hover is an enhancement: the same mapping is in the figure's <desc> and in each
     mentor's "Projects in this Site" list, so nothing here is the only route to it. */
  .mentormap-fig .node, .mentormap-fig .link { transition: opacity .15s ease, stroke-width .15s ease; }
  .mentormap-fig .mnode, .mentormap-fig .pnode { cursor: default; }
  /* Neutral, not brand: the figure's colors already encode thrusts, and the dimming
     carries the signal — a red outline would read as a fourth data color. */
  .mentormap-fig .mnode:hover .box,
  .mentormap-fig .pnode:hover .box { stroke: var(--text-primary); stroke-width: 1.75; }
  @media (prefers-reduced-motion: reduce) {
    .mentormap-fig .node, .mentormap-fig .link { transition: none; }
  }
</style>
