---
import Base from '../layouts/Base.astro';
---

<Base
  title="Broader Impacts"
  eyebrow="Broader Impacts"
  section="(g)"
  lede="Expanding research access for students from institutions with limited advanced computing resources, while strengthening collaboration across AI, HPC, cybersecurity, and software engineering."
  description="Broader impacts of the ASPIRE REU Site."
>
  <div class="wrap section">
    <h2 style="margin-top:0" id="impacts">Broader impacts</h2>
    <div class="grid grid-4">
      <div class="card">
        <h3 style="margin-top:0">Workforce development</h3>
        <p>
          The Site helps develop the next generation of the STEM and AI-ready workforce through hands-on
          research at the intersection of AI and HPC — aligning with national priorities and NSF's
          FY 2026–2030 strategic priorities in STEM and AI-ready workforce development.
        </p>
      </div>
      <div class="card">
        <h3 style="margin-top:0">Expanded research access</h3>
        <p>
          The program expands research opportunities for students from institutions with limited access to
          undergraduate research and advanced computing resources, and gives participants access to TTU's
          research community and NSF-funded advanced computing resources such as REPACSS.
        </p>
      </div>
      <div class="card">
        <h3 style="margin-top:0">Student dissemination</h3>
        <p>
          Students share their research through presentations and, as projects develop, pursue conference
          presentations and peer-reviewed publications — building on their interests, knowledge, and
          strengths through mentoring and professional development.
        </p>
      </div>
      <div class="card">
        <h3 style="margin-top:0">Research community contributions</h3>
        <p>
          The Site strengthens collaborations across AI, HPC, cybersecurity, and software engineering, and
          contributes research methods, software, and findings to the broader research community.
        </p>
      </div>
    </div>
  </div>
</Base>
