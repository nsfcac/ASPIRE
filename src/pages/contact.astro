---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { mentors } from '../data/team';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pi = mentors.find((m) => m.role.startsWith('PI'))!;
---

<Base
  title="Contact"
  eyebrow="Contact"
  lede="How prospective participants and the general public can reach the ASPIRE team."
  description="How to reach the ASPIRE REU Site team."
>
  <div class="wrap section">
    <h2 style="margin-top:0" id="mailbox">Questions about the Site</h2>
    <p class="narrow">
      If funded, we will create a shared mailbox, <b>{site.plannedEmail}</b>, for prospective
      participants and the general public to reach out to us and inquire about any questions they
      have. The mailbox is monitored by the Site leadership, so questions about the program, the
      projects, eligibility, or the application process all reach the right person.
    </p>
    <div class="callout">
      <b>Not yet active.</b> {site.plannedEmail} will open once the Site is funded — until then it will
      not receive mail. In the meantime, questions can go to the Principal Investigator, {pi.name}, in
      the Department of Computer Science at {site.institution} — see the
      <a href={`${base}/mentors`}>mentor profiles</a>.
    </div>

    <h2 id="applying">Applying to the program</h2>
    <p class="narrow">{site.contactNote}</p>
  </div>
</Base>
